{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaic.local/schemas/appsettings.schema.json",
  "title": "Mosaic appsettings.json",
  "description": "Application-level configuration. Validated at startup; invalid settings prevent Mosaic from starting. See schemas/EXAMPLES.md for a commented example and the MOSAIC_* environment-variable override table.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "default": "127.0.0.1",
      "description": "Listen host. Anything other than 127.0.0.1/localhost/::1 is treated as an external bind and triggers a startup warning."
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 4930 },
    "publicBaseUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "default": null,
      "description": "Absolute base URL to use when generating links behind a reverse proxy."
    },
    "trustedProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "trustedHeaders": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["x-forwarded-for", "x-forwarded-proto", "x-forwarded-host"]
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["error", "warn", "info", "debug"], "default": "info" },
        "directory": { "type": "string", "minLength": 1, "default": "logs" }
      }
    },
    "developmentMode": {
      "type": "boolean",
      "default": false,
      "description": "When true, error responses may include stack traces and extra diagnostic detail. Never enable in production."
    },
    "pageSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "integer", "minimum": 1, "default": 50 },
        "max": { "type": "integer", "minimum": 1, "default": 500 }
      }
    },
    "maxConcurrentQueriesPerRequest": { "type": "integer", "minimum": 1, "default": 4 },
    "sqlCommandTimeoutMs": { "type": "integer", "minimum": 1, "default": 15000 },
    "fileLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileSizeBytes": { "type": "integer", "minimum": 1, "default": 52428800 },
        "maxRecordCount": { "type": "integer", "minimum": 1, "default": 200000 }
      }
    },
    "maxRequestBodyBytes": { "type": "integer", "minimum": 1, "default": 1048576 },
    "exportLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRows": { "type": "integer", "minimum": 1, "default": 100000 },
        "maxBytes": { "type": "integer", "minimum": 1, "default": 104857600 }
      }
    },
    "metadataCacheTtlMs": { "type": "integer", "minimum": 0, "default": 300000 },
    "showQueryDurationInProduction": { "type": "boolean", "default": false }
  }
}
